# Telegram API credentials (get from https://my.telegram.org/apps)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION=your_session_string

# Server port
PORT=3000

# Public base URL of the deployed backend (no trailing slash), e.g. https://myapp.up.railway.app
# Used to build the X OAuth callback: <PUBLIC_URL>/api/x/auth/callback
# Register that exact callback URL in the X developer portal.
PUBLIC_URL=

# Control panel login (REQUIRED in production — protects /control and /api)
PANEL_USER=admin
PANEL_PASS=change_me

# Monitizee bot username (without @)
MONITIZEE_BOT=monitizeebot

# X (Twitter) API credentials (https://developer.x.com → your App → "Keys and tokens")
# App's "User authentication settings" must be Read and Write.
X_API_KEY=your_api_key
X_API_SECRET=your_api_secret
# Access tokens are OPTIONAL here — the panel's "Connect X Account" button
# generates and saves them automatically via the OAuth login flow.
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Bearer token is app-only (read-only) — NOT used for posting, optional
X_BEARER_TOKEN=
